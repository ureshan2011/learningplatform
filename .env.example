# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# This file is for LOCAL DEVELOPMENT. In production these values live in
# apphosting.yaml (public config) and Cloud Secret Manager (secrets) —
# see README.md → Deploying.
#
# These six become Secret Manager entries in production:
#   ZOOM_SDK_SECRET  ZOOM_S2S_CLIENT_SECRET  ZOOM_WEBHOOK_SECRET_TOKEN
#   PAYHERE_MERCHANT_SECRET  R2_ACCESS_KEY_ID  R2_SECRET_ACCESS_KEY
# ---------------------------------------------------------------------------

# --- Platform -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Namespaces all data. Keep "default" until Phase 4 multi-tenancy.
NEXT_PUBLIC_TENANT_ID=default

# --- Firebase (client, safe to expose) -----------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Realtime Database carries ALL live class traffic (chat, presence, quiz).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Firebase Admin (LOCAL DEVELOPMENT ONLY) ------------------------------
# In production these are NOT set: Firebase App Hosting authenticates with
# Application Default Credentials (the Cloud Run service account), so the
# private key never exists there. See lib/firebase/admin.ts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private key including \n escapes, wrapped in quotes.
FIREBASE_PRIVATE_KEY=

# --- Zoom Server-to-Server OAuth app --------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
# Secret token from the Zoom app's Feature tab, used to verify webhooks.
ZOOM_WEBHOOK_SECRET_TOKEN=
# The Zoom user (email or userId) that hosts classes.
ZOOM_HOST_USER_ID=

# --- Zoom Meeting SDK app (separate app from the S2S one) -----------------
NEXT_PUBLIC_ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# SDK build served from source.zoom.us. Pin it; bump deliberately.
NEXT_PUBLIC_ZOOM_SDK_VERSION=3.13.2

# --- PayHere --------------------------------------------------------------
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "sandbox" until you have tested a real end-to-end payment.
NEXT_PUBLIC_PAYHERE_MODE=sandbox

# --- Cloudflare R2 (notes, past papers, recordings — zero egress fees) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# --- AI (Phase 3) ---------------------------------------------------------
# Free tier via Google AI Studio. Never send student PII to the free tier.
GEMINI_API_KEY=

# --- Parent view links (optional) -----------------------------------------
# Signs the read-only parent dashboard link. If left blank, a key derived
# from your Firebase project id is used instead, so this feature works with
# no setup — set this for a link that survives a project migration.
PARENT_LINK_SECRET=
