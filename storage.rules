rules_version = '2';

// Firebase Storage holds bank deposit slips and every note, past paper and
// recording — all of it, notes and papers included. Downloads never go
// through these rules: `lib/content/storage.ts` mints a signed URL from the
// server after checking `hasAccess()` (or that the item is public), and a
// signed URL is valid on its own regardless of what a rule below says. So
// `content/` denies read entirely here — a signed URL is the only way in.
service firebase.storage {
  match /b/{bucket}/o {

    match /slips/{userId}/{fileName} {
      // A student uploads their own deposit slip and may re-read it.
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');

      allow delete: if false; // slips are payment evidence — keep the audit trail
    }

    // Teacher/admin uploads notes and past papers straight from the browser
    // (see ContentUploadForm) — the same direct-to-Storage pattern as slips,
    // just gated by role instead of ownership. `hasAdminCredentials`-backed
    // server routes (Admin SDK) bypass these rules entirely, so the delete
    // endpoint at /api/teacher/content works regardless of what's below.
    //
    // The content type list also covers the Campus Survival Pack's files:
    // Office documents, a Jupyter notebook, CSV and the two Zotero
    // bibliography formats. Browsers disagree about what a .ris or .bib is, and
    // several send nothing at all, which is why the list ends with
    // application/octet-stream. That is not the hole it looks like — write here
    // still requires a teacher or admin token, and reads are denied outright.
    match /content/{allPaths=**} {
      allow read: if false;
      allow write: if request.auth != null
        && request.auth.token.role in ['teacher', 'admin']
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/.*|video/.*|application/vnd.openxmlformats-officedocument.*|application/x-ipynb\\+json|text/.*|application/zip|application/x-research-info-systems|application/octet-stream');
      allow delete: if request.auth != null && request.auth.token.role in ['teacher', 'admin'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
